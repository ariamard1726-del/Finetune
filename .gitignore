# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.env
.venv
env/
venv/

# Model weights (مدل‌های پایه حجیم را نادیده بگیر)
models/base/
*.bin
*.safetensors

